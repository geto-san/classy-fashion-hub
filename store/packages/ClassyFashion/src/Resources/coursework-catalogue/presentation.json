  "pages": {
    "about-us": {
      "title": "About Classy Fashion Hub",
      "text": "Classy Fashion Hub is a student fashion-store project showing a complete shopping and administration experience. Explore collections, create an account and follow an order through the system."
    },
    "contact-us": {
      "title": "Contact Us",
      "text": "For questions about this project or an example order, contact the project administrator using the details supplied with your presentation. You can also use the shop assistant to explore products and order information."
    },
    "customer-service": {
      "title": "Customer Service",
      "text": "Browse the collections, choose a product and add it to your cart. Your account keeps order history and delivery details together. The project administrator can demonstrate order confirmation, payment, dispatch and delivery."
    },
    "privacy-policy": {
      "title": "Privacy Policy",
      "text": "This academic project stores account details, addresses and order records to demonstrate an online shop. Use example contact details during testing. Passwords use the application authentication system, and notification previews remain in private project logs. Ask the project administrator to remove your example account when the presentation is complete."
    },
    "terms-conditions": {
      "title": "Terms & Conditions",
      "text": "This website is an academic storefront. Catalogue prices and stock are presentation data. Practice payments do not transfer money, and no real goods are dispatched through this project. Use example details when exploring checkout."
    },
    "terms-of-use": {
      "title": "Terms of Use",
      "text": "Use this project to explore the shopping and administration workflow. Keep login details private, use example personal information and contact the project administrator if you find an issue."
    },
    "payment-policy": {
      "title": "Payment Information",
      "text": "The coursework payment flow lets you demonstrate approval, decline and pending outcomes without moving money. Cash on delivery shows the alternative order workflow. Payment records are kept so that orders and reports can be demonstrated."
    },
    "shipping-policy": {
      "title": "Delivery Information",
      "text": "Checkout includes a delivery address, delivery instructions and the displayed delivery fee. Staff can demonstrate packing, dispatch and delivery statuses. These are presentation workflows; this academic deployment does not arrange real deliveries."
    },
    "return-policy": {
      "title": "Returns",
      "text": "Contact the project administrator with an example order number to walk through the return workflow. This academic storefront does not supply or collect real merchandise."
    },
    "refund-policy": {
      "title": "Refunds",
      "text": "Refund-related records and order statuses are used to explain the shop workflow. Practice payments do not move money, so this project does not issue real refunds."
    },
    "whats-new": {
      "title": "What Is New",
      "text": "Explore new arrivals across Women, Men, Outerwear and Accessories. Product names, photographs, galleries, categories and stock can be managed from the administration area."
    }
  }
