APP_NAME="Classy Fashion Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_DEBUG_ALLOWED_IPS=
APP_URL=http://localhost
APP_ADMIN_URL=admin
APP_TIMEZONE=Africa/Kampala

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_CURRENCY=UGX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=bagisto-dynamic-smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# E-mail: the default sender below is Bagisto's admin-configurable SMTP.
# For a deployment, set MAIL_MAILER=smtp plus the MAIL_* values from your
# provider (Brevo, Mailtrap, Gmail app password...). ADMIN_MAIL_ADDRESS
# receives the low-stock alerts.
MAIL_FROM_ADDRESS=shop@example.com
MAIL_FROM_NAME="Classy Fashion Hub"
ADMIN_MAIL_ADDRESS=admin@example.com
ADMIN_MAIL_NAME=Admin
CONTACT_MAIL_ADDRESS=contact@example.com
CONTACT_MAIL_NAME=Contact

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_HOST=localhost
VITE_PORT=

# Classy Fashion Hub: Flutterwave mobile money (MTN / Airtel, report 9.6).
# Sandbox (test) keys only. Never commit real keys. Production switch =
# live keys + FLUTTERWAVE_SANDBOX=false after merchant approval.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_SANDBOX=true
# Minutes an unapproved mobile-money prompt stays open before it expires.
FLUTTERWAVE_PENDING_MINUTES=30

# Production credentials (APP_ENV=production). Leave blank to get random
# passwords printed once in the deploy log by `artisan classy:secure-accounts`.
# Locally (APP_ENV=local) the documented test passwords in README.md apply.
SEED_DEMO=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_WORKER_PASSWORD=
SEED_CUSTOMER_PASSWORD=
