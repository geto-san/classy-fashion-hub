# Bagisto core: reinstalled via `composer create-project` (see README.md).
# Project customizations inside store/ are tracked explicitly with
# `git add -f` (seeders, tests, ClassyFashion package, docs hooks) and
# are listed in README.md under "Custom code".
/store/*
!/store/packages/
/store/packages/*
!/store/packages/ClassyFashion/
!/store/packages/Webkul/
/store/packages/Webkul/*
!/store/packages/Webkul/Shop/
/store/packages/Webkul/Shop/*
!/store/packages/Webkul/Shop/src/
/store/packages/Webkul/Shop/src/*
!/store/packages/Webkul/Shop/src/Http/
/store/packages/Webkul/Shop/src/Http/*
!/store/packages/Webkul/Shop/src/Http/Requests/
/store/packages/Webkul/Shop/src/Http/Requests/*
!/store/packages/Webkul/Shop/src/Http/Requests/CartAddressRequest.php

# Secrets and local environment — never commit.
.env
*.env.local
*.env.*.local

# Dependencies and front-end build outputs.
vendor/
node_modules/

# Laravel runtime, caches and logs.
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*
*.log

# OS and editor noise.
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.~lock.*

backups/

# Cancellation must not load the disabled booking module for fashion items.
!/store/packages/Webkul/Sales/
/store/packages/Webkul/Sales/*
!/store/packages/Webkul/Sales/src/
/store/packages/Webkul/Sales/src/*
!/store/packages/Webkul/Sales/src/Models/
/store/packages/Webkul/Sales/src/Models/*
!/store/packages/Webkul/Sales/src/Models/OrderItem.php

# Shipped shop photography and storefront coverage.
!/store/public/
/store/public/*
!/store/public/images/
/store/public/images/*
!/store/public/images/storefront/
!/store/tests/
/store/tests/*
!/store/tests/Feature/
/store/tests/Feature/*
!/store/tests/Feature/StorefrontTest.php

# Ethereal storefront sources must travel with the checkout.
!/store/public/css/
/store/public/css/*
!/store/public/css/classy-ethereal.css
!/store/packages/Webkul/Shop/tailwind.config.js
!/store/public/.gitignore
!/store/public/fonts/
/store/public/fonts/*
!/store/public/fonts/work-sans/
!/store/public/css/classy-ethereal-footer.css
!/store/public/css/classy-ethereal-product.css

# Migration configuration and PostgreSQL acceptance tests.
!/store/config/
/store/config/*
!/store/config/concord.php
!/store/config/breadcrumbs.php
!/store/config/database.php
!/store/config/filesystems.php
!/store/config/mail.php
!/store/config/services.php
!/store/phpunit.xml
!/store/tests/Unit/
/store/tests/Unit/*
!/store/tests/Unit/CloudinaryAdapterTest.php
!/store/packages/Webkul/Admin/src/Routes/web/
!/store/packages/Webkul/Core/
/store/packages/Webkul/Core/*
!/store/packages/Webkul/Core/src/
/store/packages/Webkul/Core/src/*
!/store/packages/Webkul/Core/src/Console/
/store/packages/Webkul/Core/src/Console/*
!/store/packages/Webkul/Core/src/Console/Commands/
/store/packages/Webkul/Core/src/Console/Commands/*
!/store/packages/Webkul/Core/src/Console/Commands/TranslationsChecker.php
__pycache__/
!/store/packages/Webkul/Admin/
/store/packages/Webkul/Admin/*
!/store/packages/Webkul/Admin/src/
/store/packages/Webkul/Admin/src/*
!/store/packages/Webkul/Admin/src/Routes/
/store/packages/Webkul/Admin/src/Routes/*
!/store/packages/Webkul/Admin/src/Routes/web/
/store/packages/Webkul/Admin/src/Routes/web/*
!/store/packages/Webkul/Admin/src/Routes/web/catalog-routes.php
!/store/packages/Webkul/Admin/src/Routes/web/sales-routes.php
!/store/tests/Feature/CloudStorageConfigurationTest.php
!/store/tests/Feature/CallbackSecurityTest.php

!/store/tests/Feature/DeploymentReadinessTest.php
