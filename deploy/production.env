# Classy Fashion Hub — PRODUCTION env (upload-ready template).
# Fill every empty value, then upload/provide as environment variables.
# NEVER commit this file with real secrets (it stays a template in git).
# If your host takes a file upload, copy this to `.env` and fill it in.

APP_NAME="Classy Fashion Hub"
APP_ENV=production
APP_DEBUG=false
LOG_CHANNEL=stderr
LOG_LEVEL=warning
APP_DEBUG_ALLOWED_IPS=
APP_URL=https://YOUR-APP.up.railway.app
APP_ADMIN_URL=admin
APP_TIMEZONE=Africa/Kampala
# Generate: `php artisan key:generate --show` (keep the generated value unchanged across redeployments)
APP_KEY=

# --- Railway MySQL (Railway service -> Variables tab; all are secret) ---
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# --- MTN MoMo (leave empty until keys exist; with MOMO_TILL_NUMBER set the
# manual Till flow is offered instead; with neither the method hides itself) ---
MOMO_PROVIDER=auto
MOMO_TILL_NUMBER=
MTN_TARGET_ENV=sandbox
MTN_SUBSCRIPTION_KEY=
MTN_API_USER_ID=
MTN_API_KEY=

# --- Demo content for client testing (set false once live) ---
SEED_DEMO=false
# Logins. Blank = random password printed ONCE in the deploy log, so set at
# least SEED_ADMIN_PASSWORD before the first deploy. Worker/customer ones only
# matter while SEED_DEMO=true. Never commit real values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_WORKER_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# --- Optional shop-assistant LLM (blank = rule-based answers only) ---
AI_LLM_API_KEY=

# Persistent uploads: mount a Railway volume at /var/www/html/storage.
FILESYSTEM_DISK=public

# Resend SMTP: use a sender from your verified domain.
# Set MAIL_MAILER=smtp above after configuring these values.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Classy Fashion Hub"
ADMIN_MAIL_ADDRESS=
CONTACT_MAIL_ADDRESS=
