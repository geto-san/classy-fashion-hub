# Classy Fashion Hub — PRODUCTION env (upload-ready template).
# Fill every empty value, then upload/provide as environment variables.
# NEVER commit this file with real secrets (it stays a template in git).
# If your host takes a file upload, copy this to `.env` and fill it in.

APP_NAME="Classy Fashion Hub"
APP_ENV=production
APP_DEBUG=false
APP_DEBUG_ALLOWED_IPS=
APP_URL=https://classy-fashion-hub.onrender.com
APP_ADMIN_URL=admin
APP_TIMEZONE=Africa/Kampala
# Generate: `php artisan key:generate --show` (or let Render generate it)
APP_KEY=

# --- Railway MySQL (Railway service -> Variables tab; all are secret) ---
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# --- Flutterwave sandbox (leave empty until keys exist; method hides itself) ---
FLUTTERWAVE_SANDBOX=true
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# --- Demo content for client testing (set false once live) ---
SEED_DEMO=true
